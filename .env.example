POSTGRES_DB=local_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_PORT=5434

# Ollama. Leave the URL alone for a local `ollama serve`;
# docker compose overrides it to host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3:4b-instruct
EMBED_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:latest
NUM_CTX=8192

# HRMS. Only needed to answer for a specific employee. Nothing here identifies
# anyone: the session belongs to whoever logs in at the browser.
HRMS_BASE_URL=
# One entry per service, comma separated - identity and leave balances rarely
# live together. `label=url` names the group, a bare path is joined to
# HRMS_BASE_URL, and {field} is filled from an earlier response:
#   HRMS_PROFILE_SOURCES=api/users/me,wfh=https://att.example.com/api/{employee_id}/wfh
HRMS_PROFILE_SOURCES=api/me   # run `discover` to find yours

# Where `--login` sends the browser. Defaults to HRMS_BASE_URL.
HRMS_LOGIN_URL=
# Narrows which request `--login` reads the session from, so it cannot pick up
# one meant for analytics or error reporting. Match your own API path.
HRMS_API_HINT=/api/

# Prefer `--login`, or `--prompt-token` to paste one, over keeping a live
# credential in a file.
# HRMS_TOKEN=
